flowchart TD
    S["<b>step()</b> advances one bar"]
    T["transfers decided at the last<br/>close land in their wallets"]
    G["funding stamped between the rows<br/>charged at the last mark"]
    F["<b>0</b> liquidation fence worked out,<br/>the bar clipped where the margin ran out"]
    A["<b>1</b> pending market orders<br/>fill at the open"]
    B["<b>2</b> resting limits and stops<br/>fill against the clipped range"]
    D["<b>3</b> liquidation checked at<br/>the bar adverse extreme,<br/>debits inside the bar counted"]
    C["<b>4</b> funding the row owns charged<br/>at the close, on the position<br/>still held"]
    E["<b>5</b> equity marked at the close,<br/>new state returned"]

    S --> T
    T --> G
    G --> F
    F --> A
    A --> B
    B --> D
    D --> C
    C --> E

    classDef entry fill:#16232e,stroke:#4d9feb,stroke-width:2px,color:#e6edf3
    classDef stage fill:#16232e,stroke:#2ee6a6,stroke-width:2px,color:#e6edf3
    class S entry
    class T,G,F,A,B,C,D,E stage
